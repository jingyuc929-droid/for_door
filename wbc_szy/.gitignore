_isaac_sim*
_repo
_build
.lastformat

# RL-Games
**/runs/*
**/logs/*
**/recordings/*

# Pre-Trained Checkpoints
/.pretrained_checkpoints/

# 忽略所有 npz 数据文件
*.npz
*.yaml

# 忽略所有 PyTorch 模型文件
*.pt
*.pth
*.out

# 之前你提到过的图片文件
*.jpg
*.jpeg
*.png

